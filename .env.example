# ==============================================================================
# Credence Environment Configuration Example
# Copy this file to .env and configure the variables for your deployment
# ==============================================================================

# Server Environment & Port Binding
CREDENCE_ENV=production
HOST=0.0.0.0
PORT=8000

# Security & CORS Whitelist (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
CREDENCE_SECRET_KEY=generate-a-strong-random-key-for-production-min-32-chars
CREDENCE_AUTH_REQUIRED=false

# File Upload Security & Rate Limiting
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB
RATE_LIMIT_PER_MINUTE=60

# Persistent Database Storage
# Default SQLite:
DATABASE_URL=sqlite:///./data/credence.db
# Or PostgreSQL for distributed production:
# DATABASE_URL=postgresql://credence:credence_secure_pass@localhost:5432/credence

# Scholarly Retrieval API Credentials
GEMINI_API_KEY=your_gemini_api_key_here
OPENALEX_API_KEY=your_openalex_api_key_here
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
CROSSREF_MAILTO=researcher@example.com
UNPAYWALL_EMAIL=researcher@example.com
OLLAMA_HOST=http://localhost:11434

# Frontend Configuration (optional, if frontend hosted on separate domain)
VITE_API_BASE_URL=
